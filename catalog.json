  {
   "id": "gdp",
   "group": "macro",
   "topic": "Output",
   "title": "U.S. GDP over time",
   "blurb": "Nominal and real gross domestic product, GDP by component as a stacked area (consumption, investment, government, net exports), real growth, and the gap to potential output. Quarterly since 1947.",
   "panels": [
    {
     "title": "GDP level",
     "units": "Billions of dollars",
     "default_transform": "level",
     "series": [
      {
       "id": "GDP",
       "label": "Nominal GDP"
      },
      {
       "id": "GDPC1",
       "label": "Real GDP (2017 dollars)"
      },
      {
       "id": "GDPPOT",
       "label": "Real potential GDP"
      }
     ]
    },
    {
     "title": "GDP by component, nominal",
     "units": "Billions of dollars, annual rate. Bands stack to total GDP; net exports are negative when imports exceed exports.",
     "chart": "area",
     "default_transform": "level",
     "zero_line": true,
     "series": [
      {
       "id": "NETEXP",
       "label": "Net exports"
      },
